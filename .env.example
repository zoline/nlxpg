# nlxpg 설정. deploy/install.sh가 이 파일을 .env로 복사한다.
#
# .env에는 시스템 DB에 닿기 위한 값과 서버 옵션만 둔다. LLM은 DB(웹 UI 관리 → 모델 설정)에 있다.
# 값을 찾는 순서: 프로세스 환경변수 → 이 파일(.env) → ../pgxnl/.env (있을 때만, 시스템 DB 접속 폴백).
#   필수: NLXPG_SYSTEM_PG_DSN (deploy/install.sh --pg-local이 채운다), NLXPG_SECRET_KEY
# pgxnl .env 위치를 바꾸려면: NLXPG_PGXNL_ENV=/path/to/pgxnl/.env

# ── LLM ──────────────────────────────────────────────
# LLM 설정은 .env에 두지 않는다. 웹 UI 관리 → 모델 설정에서 프로필로 등록하며 시스템 DB에만
# 저장된다(키·비밀번호는 아래 NLXPG_SECRET_KEY로 암호화). 화면을 못 쓰는 서버: nlxpg setup llm
#
# 암호화 키. deploy/install.sh가 만든다(없으면 서버가 처음 뜰 때 만든다). 잃으면 LLM 키를 다시 입력한다.
# NLXPG_SECRET_KEY=

# ── 임베딩 (엔티티 정합·평가 매칭) ─────────────────── 폴백: PGXNL_EMBEDDING_*
# NLXPG_EMBEDDING_BASE_URL=
# NLXPG_EMBEDDING_MODEL=

# ── PostgreSQL ───────────────────────────────────────
# nlxpg 전용 시스템 DB. 비워 두면 PGXNL_SYSTEM_PG_DSN과 같은 서버·계정에서
# DB 이름만 NLXPG_SYSTEM_DB_NAME(기본 nlxpg)으로 바꿔 쓴다. 생성·스키마 적용: nlxpg db init
# NLXPG_SYSTEM_PG_DSN=
# NLXPG_SYSTEM_DB_NAME=nlxpg
# DDL 샌드박스 검증용. 비워 두면 시스템 DB를 쓴다.
# 검증은 임시 스키마를 만들고 트랜잭션을 항상 롤백하므로 흔적을 남기지 않는다.
# NLXPG_SANDBOX_PG_DSN=

# ── 공통표준 (ADR-0005) ──────────────────────────────
# 명명·타입에 공공데이터 공통표준(data/standards/)을 적용한다.
# NLXPG_APPLY_STANDARDS=true
# NLXPG_STANDARDS_DIR=data/standards
# 비우면 가장 최근 판
# NLXPG_STANDARDS_VERSION=

# ── 웹 UI (nlxpg serve) ──────────────────────────────
# 사용자가 한 명도 없을 때 서버가 만드는 첫 관리자(admin)의 초기 비밀번호.
# 비우면 무작위로 만들어 서버 로그(out/serve.log)에 한 번만 남긴다. 첫 로그인 때 바꾸게 한다.
# NLXPG_ADMIN_INITIAL_PASSWORD=
# NLXPG_API_HOST=0.0.0.0
# NLXPG_API_PORT=8200
# 업로드 문서 저장 위치 (커밋 금지 경로)
# NLXPG_UPLOAD_DIR=data/private/uploads

# ── 파이프라인 ────────────────────────────────────────
# 섹션 분할 상한(문자 수). 장문 문서는 섹션 단위로 추출한 뒤 정합 단계에서 병합한다.
# NLXPG_CHUNK_MAX_CHARS=12000
# NLXPG_EXTRACT_CONCURRENCY=4
